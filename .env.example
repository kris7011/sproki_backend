# OIDC / MitID (Signaturgruppen Sandbox eksempler)
OIDC_CLIENT_ID=sproki-local
OIDC_CLIENT_SECRET=changeme
OIDC_AUTH_URL=https://oidc.sandbox.signaturgruppen.dk/authorize
OIDC_TOKEN_URL=https://oidc.sandbox.signaturgruppen.dk/token
OIDC_JWKS_URL=https://oidc.sandbox.signaturgruppen.dk/jwks
OIDC_ISSUER=https://oidc.sandbox.signaturgruppen.dk/
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_SCOPE=openid profile email

# General
SPROKI_UPLOAD_DIR=./uploads
SPROKI_DB_URL=sqlite:///./sproki.db
